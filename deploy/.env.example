# Database identities — required secrets are injected by the deployment platform.
PAYOPS_DATABASE_NAME=<required-database-name>
PAYOPS_DATABASE_ADMIN_ROLE=<required-admin-role>
PAYOPS_DATABASE_ADMIN_PASSWORD=<secret>
PAYOPS_DATABASE_ADMIN_URL=<secret>
PAYOPS_MIGRATOR_ROLE=<required-migrator-role>
PAYOPS_MIGRATOR_PASSWORD=<secret>
PAYOPS_MIGRATOR_DATABASE_URL=<secret>
PAYOPS_RUNTIME_ROLE=<required-runtime-role>
PAYOPS_RUNTIME_PASSWORD=<secret>
PAYOPS_RUNTIME_DATABASE_URL=<secret>
PAYOPS_CONTROL_ROLE=<required-control-role>
PAYOPS_CONTROL_PASSWORD=<secret>
PAYOPS_CONTROL_DATABASE_URL=<secret>
PAYOPS_READINESS_VERIFIER_ROLE=<required-verifier-role>
PAYOPS_READINESS_VERIFIER_PASSWORD=<secret>
PAYOPS_READINESS_VERIFIER_DATABASE_URL=<secret>
PAYOPS_SHADOW_PROJECTOR_ROLE=<required-projector-role>
PAYOPS_SHADOW_PROJECTOR_PASSWORD=<secret>
PAYOPS_SHADOW_PROJECTOR_DATABASE_URL=<secret>

# Public/server identity — required.
PAYOPS_ENVIRONMENT=production
PAYOPS_PUBLIC_API_ORIGIN=<required-https-origin>
PAYOPS_CHECKOUT_ORIGIN=<required-https-origin>
PAYOPS_WEB_ORIGIN=<required-https-origin>
PAYOPS_TRUSTED_ORIGINS=<required-https-origin-list>
PAYOPS_WALLET_PROOF_DOMAIN=<required-domain>

# Authentication and public checkout — required secrets.
BETTER_AUTH_SECRETS=<secret-key-ring>
PAYOPS_CHECKOUT_TOKEN_KEYS=<secret-key-ring>
PAYOPS_BOOTSTRAP_INVITATION_URL=<required-https-origin>

# Two independent Solana RPC providers — required.
PAYOPS_RPC_PRIMARY_PROVIDER_ID=<required-provider-id>
PAYOPS_PRIMARY_SOLANA_RPC_URL=<secret-or-private-endpoint>
PAYOPS_RPC_SECONDARY_PROVIDER_ID=<required-distinct-provider-id>
PAYOPS_SECONDARY_SOLANA_RPC_URL=<secret-or-private-endpoint>

# Optional, bounded public-wallet analysis. Keep both feature flags false until rollout prerequisites pass.
PAYOPS_PUBLIC_ANALYSIS_ENABLED=false
PAYOPS_PUBLIC_ANALYSIS_CLIENT_DIGEST_SECRET=<required-base64url-secret-when-enabled>
PAYOPS_PUBLIC_ANALYSIS_CLIENT_LIMIT=5
PAYOPS_PUBLIC_ANALYSIS_GLOBAL_LIMIT=100
PAYOPS_PUBLIC_ANALYSIS_WINDOW_SECONDS=60
PAYOPS_PUBLIC_WALLET_ANALYSIS_ENABLED=false

# Pricing and email — required.
PAYOPS_PYTH_HERMES_ENDPOINT=<required-https-endpoint>
PAYOPS_PYTH_ACCESS_TOKEN=<secret>
PAYOPS_PYTH_USDC_FEED_ID=<required-feed-id>
PAYOPS_PYTH_USDT_FEED_ID=<required-feed-id>
PAYOPS_ECB_ENDPOINT=<required-https-endpoint>
PAYOPS_AUTH_EMAIL_ENDPOINT=<required-https-endpoint>
PAYOPS_AUTH_EMAIL_TOKEN=<secret>
PAYOPS_EMAIL_DELIVERY_MODE=production

# Evidence — required in production.
PAYOPS_EVIDENCE_SIGNING_KEY_ID=<required-key-id>
PAYOPS_EVIDENCE_SIGNING_PRIVATE_KEY_B64=<secret>

# Worker — required, bounded values shown.
PAYOPS_PARSER_VERSION=0.2.0
PAYOPS_BUILD_REVISION=<immutable-revision>
PAYOPS_WORKER_INTERVAL_MS=2000
PAYOPS_WORKER_BATCH_SIZE=50
PAYOPS_WORKER_CONCURRENCY=4
PAYOPS_WORKER_LEASE_MS=30000

# Optional authenticated commercial FX. Set both or neither; USD remains the only production invoice currency without both.
PAYOPS_COMMERCIAL_FX_ENDPOINT=<optional-https-endpoint>
PAYOPS_COMMERCIAL_FX_TOKEN=<optional-secret>

# Webhook sender secrets use the exact environment-variable names stored with each endpoint.
PAYOPS_WEBHOOK_SECRET_CURRENT=<endpoint-specific-secret>
PAYOPS_WEBHOOK_SECRET_PREVIOUS=<optional-overlap-secret>

# Smoke-only values generated by deploy/smoke/run.mjs; never configure these in production.
PAYOPS_SMOKE_SECRET_DIRECTORY=<generated-temporary-directory>
PAYOPS_SMOKE_API_PORT=<generated-loopback-port>
PAYOPS_SMOKE_WEB_PORT=<generated-loopback-port>
