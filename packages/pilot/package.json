{
  "name": "@payops/pilot",
  "version": "0.1.0",
  "description": "Resumable merchant shadow audits for Solana payment operations",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/GautamBytes/solana-payment-ops.git",
    "directory": "packages/pilot"
  },
  "homepage": "https://github.com/GautamBytes/solana-payment-ops#readme",
  "bugs": {
    "url": "https://github.com/GautamBytes/solana-payment-ops/issues"
  },
  "keywords": [
    "solana",
    "payments",
    "audit",
    "reconciliation",
    "merchants"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "payops-pilot": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "examples",
    "migrations",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "pnpm run test:unit && pnpm run test:dist",
    "test:dist": "pnpm run build && node test/package.esm-smoke.mjs && node test/cli.esm-smoke.mjs",
    "test:unit": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@payops/core": "workspace:^0.1.0",
    "@payops/ingestion": "workspace:^0.1.0",
    "@payops/reconciliation": "workspace:^0.1.0",
    "@payops/webhooks": "workspace:^0.1.0",
    "@solana/kit": "7.1.0",
    "postgres": "3.4.7",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "vitest": "4.1.10"
  }
}
