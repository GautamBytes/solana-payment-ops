{
  "name": "@payops/core",
  "version": "0.1.0",
  "description": "Deterministic Solana payment parsing and verification primitives",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/GautamBytes/solana-payment-ops.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/GautamBytes/solana-payment-ops#readme",
  "bugs": {
    "url": "https://github.com/GautamBytes/solana-payment-ops/issues"
  },
  "keywords": [
    "solana",
    "payments",
    "verification",
    "solana-pay",
    "typescript"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "payops-conformance": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./fixtures/v0.1/manifest.json": "./dist/fixtures/v0.1/manifest.json",
    "./fixtures/v0.1/cases/*": "./dist/fixtures/v0.1/cases/*"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-fixtures.mjs",
    "conformance": "tsc -p tsconfig.build.json && node dist/cli.js",
    "test": "pnpm run test:unit && pnpm run test:dist",
    "test:dist": "pnpm run build && node test/manifest-cli.esm-smoke.mjs",
    "test:unit": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@payops/contracts": "workspace:^0.1.0",
    "@solana/kit": "7.0.0",
    "bs58": "6.0.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "vitest": "4.1.10"
  }
}
