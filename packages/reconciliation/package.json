{
  "name": "@payops/reconciliation",
  "version": "0.2.0",
  "description": "Deterministic invoice reconciliation for finalized Solana payments",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/GautamBytes/solana-payment-ops.git",
    "directory": "packages/reconciliation"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "payops-reconciliation": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "examples",
    "migrations",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@payops/core": "workspace:^0.1.0",
    "@payops/webhooks": "workspace:^0.1.0",
    "@solana/kit": "7.0.0",
    "csv-parse": "7.0.2",
    "postgres": "3.4.7"
  },
  "devDependencies": {
    "@payops/ingestion": "workspace:^0.2.0",
    "vitest": "4.1.10"
  }
}
