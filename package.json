{
  "name": "solana-payment-ops",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@11.15.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "check": "pnpm build && pnpm format:check && pnpm typecheck && pnpm test",
    "containers:build": "node scripts/build-containers.mjs",
    "containers:test": "node deploy/smoke/run.mjs",
    "conformance": "pnpm --filter @payops/core conformance",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "hosted:self-serve:check": "node scripts/check-hosted-self-serve.mjs",
    "openapi:check": "node scripts/check-openapi.mjs && node scripts/generate-sdk.mjs --check",
    "packages:verify": "pnpm build && node scripts/verify-public-packages.mjs",
    "pilot": "pnpm --filter @payops/pilot exec payops-pilot",
    "release:verify": "pnpm check && pnpm schemas:check && pnpm openapi:check && pnpm conformance fixtures/v0.1/manifest.json && pnpm packages:verify && pnpm audit --prod",
    "schemas:check": "pnpm --filter @payops/contracts build && node scripts/check-json-schemas.mjs",
    "sdk:generate": "node scripts/generate-sdk.mjs",
    "test": "pnpm -r --workspace-concurrency=1 test && node --test scripts/test/*.test.mjs",
    "test:e2e": "playwright test",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.62.1",
    "@types/node": "22.20.1",
    "prettier": "3.9.6",
    "typescript": "7.0.2"
  }
}
